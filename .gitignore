# file system binaries
.DS_Store

# virtual environments
.venv

# python build/runtime artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# editor / tooling local settings
.claude/
.vscode/
.idea/

# sample output folders (generated when running the sample scripts)
sample_output/
sample_output_batch/
sample_output_threaded_deid/

# local-only: diagrams and the scripts that built the census data. Not shipped to
# clients, who consume the census JSON rather than regenerating it.
docs/*
tools/*

# Raw famous-name blocklist: 180 MB, over GitHub's 100 MB per-file limit. Kept
# locally because it is only needed to rebuild data/blocked_pairs.bin, which is the
# compiled index the package actually loads.
limina_postprocessor/data/famous_names_blocklist.txt

# Internal test suite. Kept out of the client-facing repo, which ships the package
# and the samples only.
tests/*
